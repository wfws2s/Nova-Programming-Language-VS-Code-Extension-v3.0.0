# ==============================================================================
#  Nova .gitignore
# ==============================================================================

# Build directories
build/
build-*/
build_*/
bin/
out/
cmake-build-*/
x64/
x86/
Debug/
Release/

# Compiled object files & libraries
*.o
*.obj
*.a
*.lib
*.dll
*.dylib
*.so
*.exp
*.ilk
*.pdb
*.idb

# Executables (compiled binaries generated by build systems)
# Note: Keep distributed release setup if in release folder, but ignore root built executables
build/nova.exe
build/nova
build/installer/nova-setup.exe
*.exe

# CMake artifacts
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Ninja
.ninja_deps
.ninja_log
build.ninja

# IDEs and Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.user
*.user.*
.vs/
.cache/

# OS specific
Thumbs.db
Desktop.ini
.DS_Store

# Logs and test outputs
*.log
LastTest.log
LastTestsFailed.log
