// Windows Resource File for Nova Installer / Setup
#include <windows.h>

1 ICON "../logo/R-removebg-preview.ico"

1 VERSIONINFO
FILEVERSION     0,2,2,0
PRODUCTVERSION  0,2,2,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Nova Language Project"
            VALUE "FileDescription",  "Nova Programming Language Installer"
            VALUE "FileVersion",      "0.2.2.0"
            VALUE "InternalName",     "nova-setup"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "nova-setup.exe"
            VALUE "ProductName",      "Nova Setup"
            VALUE "ProductVersion",   "0.2.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
